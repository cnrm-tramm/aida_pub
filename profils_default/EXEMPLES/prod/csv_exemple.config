# Ce fichier INI décrit le contenu du fichier à générer par le programme
#   prod_csv.py
#
# Le format de ce fichier INI est donné par la commande :
#   prod_csv.py -h


[general]
entete = oui
champs = T_2m,P_1m,Hum_2m
separateur = " "
missval = -9999.0000
fmt_date_heure = %Y-%m-%d:%H%M

[T_2m]
plateforme = ts
vecteur = tpr_air_bs_c1_cal_%60 
format = 0.4f

[P_1m]
plateforme = ts
vecteur =  pre_air_c1_cal_%60
format = 0.4f
unite = hectoPascal 

[Hum_2m]
plateforme = ts
vecteur =  hum_relcapa_bs_c1_cal_%60
format = 0.4f

