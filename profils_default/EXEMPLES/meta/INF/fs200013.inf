[FORMAT]
format_coord = C (D)DDdMM.X(X) (C=lettre (N,E,S ou W)), (D)DD= degres 2 ou 3 chiffres, MM=minutes, X(X)= fraction decimale de minutes;
format_heure = HHMMSS (HH= heures, MM=minutes, SS= secondes);
format_date  = JJ/MM/AAAA (JJ= jour, MM=mois, AAAA=annee, le tout en chiffres);
format_duree = HH.D (HH= heure, D= dixiemes d'heure);

