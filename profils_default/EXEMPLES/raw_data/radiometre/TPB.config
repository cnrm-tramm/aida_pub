[structure]
format_temps = seconds since 2001-01-01, 00:00:00
nom_variable_temps = rft_time_TPB
freq_ech = 0.001666667

[instru_1]
position = lat:${station_latitude} lon:${station_longitude} alt:${station_altitude} ficRET:TPB_QR_MeteoSwiss_V1.RET
chaine_acquisition = module_1 module_2
module_1 = HATPRO:RPG:G3:n° série:n° ref interne:calibration 09/2017 Toulouse
module_2 = acquisition_unit:PC Lisa:software  ${radiometer_software_version}::

[var_defaut]
instru = instru_1

[var_temperature_profiles]
nom_variable = tpr_TPB
name = profil de température dans la couche limite
english_name = troposphere temperature profil in the boundary layer
normal_min = 0
normal_max = 360
bornes = [var_altitude_layers]
unit = Kelvin

[var_rain_flag]
nom_variable = ctl_rainflag_TPB
name = indicateur de pluie
english_name = rainflag
normal_min = 0
normal_max = 1
information = @{Info}
