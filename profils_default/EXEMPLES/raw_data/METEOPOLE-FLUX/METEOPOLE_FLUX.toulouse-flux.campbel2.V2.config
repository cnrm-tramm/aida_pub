#
# Fichier de configuration campbel2
#

[structure]
debut_ligne_a_ignorer = #
separateurs_colonnes = ESPACE ,
separateurs_multiples_ignores = ESPACE ,
colonne_msg_id = col_7
temps = col_1, col_2
format_temps = %d/%m/%Y,%H:%M:%S.%f
traite_doublons = False
freq_ech = 0.016666667

[msg_1]
# BF5, CNR1, phi0, prp
nb_colonnes = 25
nom_variable_temps = rft_time_campbel21

[msg_2]
# heures de bascules RR (non traitées)
nb_colonnes = 7

[msg_3]
# capteurs PAR (non traités)
nb_colonnes = 24
nom_variable_temps = rft_time_campbel23

[msg_4]
# ventilation CNR1
nb_colonnes = 8
nom_variable_temps = rft_time_campbel24

[msg_5]
# heures de bascules RR pluvio 2 (non traitées)
nb_colonnes = 7

[col_defaut]
misval_in = NAN 
misval_out = nan

[instru_1]
#BF5
position = portique 3.15 m (1.60m % O)
chaine_acquisition=module_1 module_2
module_1 = sensor:Delta T:BF5:07/06:RYRP01:2014-12-11
module_2 = acquisition_unit:campbell:CR1000:E7417:CAC303:

[instru_2]
#CNR1
position = portique 3 m (0.6 % S, 2.0 % O, vers 180°)
chaine_acquisition=module_1 module_2
module_1 = sensor:Kipp und Zonen:CNR1:020373:RYTK01:2015-09-15
module_2 = acquisition_unit:campbell:CR1000:E7417:CAC303:

[instru_3]
#Flux dans le sol
position = dans le sol -3 cm
chaine_acquisition=module_1 module_2
module_1 = sensor:Hukseflux:HFP01:1497:RYF012:2005-04-15
module_2 = acquisition_unit:campbell:CR1000:E7417:CAC303:

[instru_4]
#Pluvio
position = N-E du portique, -0.2m/S, -5m/O, hauteur 1 m
chaine_acquisition=module_1 module_2
module_1 = sensor:Precis Mecanique:3039:23264:RRA023:2013-08-29
module_2 = acquisition_unit:campbell:CR1000:E7417:CAC303:

[instru_5]
#Capteur de rosee
position = 0.95 m, -1.5/S
chaine_acquisition=module_1 module_2
module_1 = sensor:Campbell:237:10142/2:ROS004:
module_2 = acquisition_unit:campbell:CR1000:E7417:CAC303:

[instru_6]
#Campbell
chaine_acquisition=module_1
module_1 = acquisition_unit:campbell:CR1000:E7417:CAC303:

[instru_7]
#Pluvio 2
position = N-E du portique, -0.2m/S, -5m/O, hauteur 1 m
chaine_acquisition=module_1 module_2
module_1 = sensor:Precis Mecanique:R01 3070A 0000:25397:RRA025:2019-02-11
module_2 = acquisition_unit:campbell:CR1000:E7417:CAC303:

#
# campbel21
#
[col_8@msg_1]
instru = instru_1
nom_variable = ray_rgd_bf5_c2
name = rayonnement global descendant BF5 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50 
normal_max = 1500

[col_9@msg_1]
instru = instru_1
nom_variable = ray_rdiff_bf5_c2
name = rayonnement diffus BF5 moyenne 1 min echantillonnage 10 sec  
unit = watt/m2
normal_min = -50
normal_max = 1500

[col_10@msg_1]
instru = instru_1
nom_variable = ray_inso_bf5_c2
name = duree d insolation BF5 moyenne 1 min echantillonnage 10 sec 
unit = h
normal_min = 0
normal_max = 24

[col_11@msg_1]
instru = instru_1
nom_variable = ctl_cpt_inso_bf5_c2
name = compteur acquisition BF5 moyenne 1 min echantillonnage 10 sec
unit = h
normal_min = 0
normal_max = 8640
format = Int_16
misval_out = -32000

[col_12@msg_1]
instru = instru_2
nom_variable = ray_rgd_cnr1_c2
name = rayonnement global descendant CNR1 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50
normal_max = 1500

[col_13@msg_1]
instru = instru_2
nom_variable = ray_rgm_cnr1_c2
name = rayonnement global montant CNR1 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50
normal_max = 1500

[col_14@msg_1]
instru = instru_2
nom_variable = ray_ird_cnr1_c2
name = rayonnement infra-rouge descendant CNR1 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50
normal_max = 1500

[col_15@msg_1]
instru = instru_2
nom_variable = ray_irm_cnr1_c2
name = rayonnement infra-rouge montant CNR1 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50
normal_max = 1500

[col_16@msg_1]
instru = instru_1
nom_variable = ray_tnoir_cnr1_c2
name = temperature corps noir CNR1 moyenne 1 min echantillonnage 10 sec 
unit = Celsius
normal_min = -30
normal_max = 80

[col_17@msg_1]
instru = instru_3
nom_variable = flx_phi0_1_c2
name = flux de chaleur dans le sol n 1 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50
normal_max = 500

[col_18@msg_1]
instru = instru_3
nom_variable = flx_phi0_2_c2
name = flux de chaleur dans le sol n 2 moyenne 1 min echantillonnage 10 sec 
unit = watt/m2
normal_min = -50
normal_max = 500

[col_19@msg_1]
instru = instru_3
nom_variable = flx_phi0_3_c2
name = flux de chaleur dans le sol n 3 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50
normal_max = 500

[col_20@msg_1]
instru = instru_4
nom_variable = prp_rr_min_c2
name = cumul minute de precipitation echantillonnage 1 sec
unit = millimeter
normal_min = 0
normal_max = 500

[col_21@msg_1]
instru = instru_5
nom_variable = hum_rosee_c2
name = mesure ohmique de rosee
#on utilise une gamme un peu elargie pour etudier le capteur au lieu de [0-1]
normal_min = -0.1
normal_max = 1.1

[col_22@msg_1]
instru = instru_6
nom_variable = ctl_ubat_c2
name = tension batterie echantillonnage 1 min
unit = Volts
normal_min = 0
normal_max = 20

[col_23@msg_1]
instru = instru_6
nom_variable = ctl_tint_c2
name = temperature interne echantillonnage 1 min
unit = Celsius
normal_min = -60
normal_max = 80

[col_24@msg_1]
instru = instru_7
nom_variable = prp_rr2_min_c2
name = cumul minute de precipitation echantillonnage 1 sec du pluvio 2
unit = millimeter
normal_min = 0
normal_max = 500

[col_25@msg_1]
instru = instru_3
nom_variable = flx_phi0_4_c2
name = flux de chaleur dans le sol n 4 moyenne 1 min echantillonnage 10 sec
unit = watt/m2
normal_min = -50
normal_max = 500

#
# campbel24
#
[col_8@msg_4]
instru = instru_1
nom_variable = ctl_status_fan_c2
name = status de la ventilation du CNR1 (0:non actif, 1:actif)
normal_max = 1

 
