[structure]
debut_ligne_a_ignorer = #
separateurs_colonnes = ,
#separateurs_multiples_ignores = ,
temps = NOMFIC[12:22],col_1
format_temps = %Y-%m-%d,%DS
colonne_msg_id = col_2

#
# Définition des 3 messages
#
[msg_1]
nb_colonnes = 6
nom_variable_temps = rft_time_ray
freq_ech = 0.016666667

[msg_2]
nb_colonnes = 7
nom_variable_temps = rft_time_ptuv
freq_ech = 0.016666667

[msg_3]
nb_colonnes = 4
nom_variable_temps = rft_time_rr
freq_ech = 0.002777778

#
# Définitions des colonnes du message msg_1 (RAY)
#
[col_3@msg_1]
nom_variable = ray_ird
name = rayonnement infra-rouge descendant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

[col_4@msg_1]
nom_variable = ray_irm
name = rayonnement infra-rouge montant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

[col_5@msg_1]
nom_variable = ray_rgd
name = rayonnement global descendant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

[col_6@msg_1]
nom_variable = ray_rgm
name = rayonnement global montant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

#
# Définitions des colonnes du message msg_2 (PTUV)
#
[col_3@msg_2]
nom_variable = pre_air_c1
name = pression atmospherique moyenne 1 min echantillonnage 10 sec
unit = hPa
normal_min = 700
normal_max = 1060

[col_4@msg_2]
nom_variable = tpr_air
name = temperature sous abri haut moyenne 1 min echantillonnage 10 sec
unit = celsius
normal_min = -60
normal_max = +50

[col_5@msg_2]
nom_variable = hum_relcapa
name = humidite relative sous abri haut moyenne 1 min echantillonnage 10 sec
unit = percent
normal_min = 0
normal_max = 100

[col_6@msg_2]
nom_variable = ven_ddmoy1mn
name = direction vent moyen 1 min echantillonnage 0.5s
unit = degree
normal_min = 0
normal_max = 360

[col_7@msg_2]
nom_variable = ven_ffmoy1mn
name = force vent moyen 1 min echantillonnage 0.5 sec
unit = m/s
normal_min = -0.5
normal_max = 100

#
# Définitions des colonnes du message msg_3 (RR)
#
[col_3@msg_3]
nom_variable = prp_rr_6min
name = cumul minute de precipitation echantillonnage 1 sec pluvio n°1
unit = mm
normal_min = 0
normal_max = 500

[col_4@msg_3]
nom_variable = prp_rr2_6min
name = cumul minute de precipitation echantillonnage 1 sec pluvio n°2
unit = mm
normal_min = 0
normal_max = 500

