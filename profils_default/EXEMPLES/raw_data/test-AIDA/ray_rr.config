[structure]
debut_ligne_a_ignorer = #
separateurs_colonnes = ,
#separateurs_multiples_ignores = ,
temps = col_1
format_temps = %Y-%m-%d %H:%M:%S
colonne_msg_id = col_2

#
# Définition des 2 messages
#
[msg_RAY]
nb_colonnes = 6
nom_variable_temps = rft_time_ray
freq_ech = 0.016666667

[msg_RR]
nb_colonnes = 4
nom_variable_temps = rft_time_rr
freq_ech = 0.002777778

#
# Définitions des colonnes du message msg_RAY
#
[col_3@msg_RAY]
nom_variable = ray_ird
name = rayonnement infra-rouge descendant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

[col_4@msg_RAY]
nom_variable = ray_irm
name = rayonnement infra-rouge montant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

[col_5@msg_RAY]
nom_variable = ray_rgd
name = rayonnement global descendant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

[col_6@msg_RAY]
nom_variable = ray_rgm
name = rayonnement global montant CNR1 moyenne 1 min echantillonnage 10 sec
unit = Watt/m2
normal_min = -50
normal_max = 1500

#
# Définitions des colonnes du message msg_RR
#
[col_3@msg_RR]
nom_variable = prp_rr_6min
name = cumul minute de precipitation echantillonnage 1 sec pluvio n°1
unit = mm
normal_min = 0
normal_max = 500

[col_4@msg_RR]
nom_variable = prp_rr2_6min
name = cumul minute de precipitation echantillonnage 1 sec pluvio n°2
unit = mm
normal_min = 0
normal_max = 500

