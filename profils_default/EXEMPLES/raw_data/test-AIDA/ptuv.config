[structure]
debut_ligne_a_ignorer = #
separateurs_colonnes = ,
#separateurs_multiples_ignores = ,
nb_colonnes = 6
temps = col_1
format_temps = %Y-%m-%d %H:%M:%S
freq_ech = 0.016666667

[col_2]
nom_variable = pre_air_c1
name = pression atmospherique moyenne 1 min echantillonnage 10 sec
unit = hPa
normal_min = 700
normal_max = 1060

[col_3]
nom_variable = tpr_air
name = temperature sous abri haut moyenne 1 min echantillonnage 10 sec
unit = celsius
normal_min = -60
normal_max = +50

[col_4]
nom_variable = hum_relcapa
name = humidite relative sous abri haut moyenne 1 min echantillonnage 10 sec
unit = percent
normal_min = 0
normal_max = 100

[col_5]
nom_variable = ven_ddmoy1mn
name = direction vent moyen 1 min echantillonnage 0.5s
unit = degree
normal_min = 0
normal_max = 360

[col_6]
nom_variable = ven_ffmoy1mn
name = force vent moyen 1 min echantillonnage 0.5 sec
unit = m/s
normal_min = -0.5
normal_max = 100


