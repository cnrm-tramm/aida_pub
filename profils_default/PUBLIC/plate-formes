# vim: set fileencoding=iso-8859-15 :
# -*- coding: iso-8859-15 -*-
# Les 2 lignes ci-dessus sont pour vi et emacs, respectivement.
# Le paragraphe ci-dessous est pour un parser scrupuleux.

[FORMAT]
file_encoding = iso-8859-15
format_position = latitude/longitude/altitude, ou "mobile"

# plateforme description
# [plateform]
# nom_long         = brief description
# abrev            = 2 characters in : [a-z][A-Z][0-9]
# nom_serie_mesure = one of : [Journee, Vol, Lacher, Lacher_en_vol, Drone]
# duree_vecteur    = one of : [journee, acquisition]
# position         = lat(degrees) / lon(degrees) / alt(meters) (ex : +43.574167 / +1.373889 / 157.0m)
# responsable      = platform manager
