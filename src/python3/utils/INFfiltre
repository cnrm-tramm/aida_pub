#!/usr/bin/env python3

"""
Remplacement simpliste de INFfiltre.c
    Récupération d'informations contenues dans un fichier au format .inf.

    Ce script est un _portage simplifié_ de l'ancien utilitaire INFfiltre.c
    L'ption -i est rendue obligatoire (la classe AIDA.py::Inf est peut
    compatible avec une lecture de stdin)
"""

import os
import sys

import argparse

PYTHON_X_Y = 'python%d.%d' % (sys.version_info[0], sys.version_info[1])
sys.path.append(os.path.join(os.getenv('AIDA_HOME'), 'lib', PYTHON_X_Y))

import AIDA
from fct_messages import (info, warning, stop_error, result, wait_user)


# concernant ce programme
__version__ = "1.0.0"
me = os.path.split(sys.argv[0])[1]


def print_out(rubrique, champ, valeur, read_values, out_format):
    """
    """
    if valeur:
        if isinstance(read_values, list):
            if valeur in read_values:
                read_value = valeur
                print(eval(f"f'{out_format}'"))
        else:
            if valeur == read_values:
                read_value = valeur
                print(eval(f"f'{out_format}'"))

    else: # valeur == None
        if isinstance(read_values, list):
            for read_value in read_values:
                print(eval(f"f'{out_format}'"))
        else:
            read_value = read_values
            print(eval(f"f'{out_format}'"))


if __name__ == '__main__':

    # format de sortie
    out_formats = {1: "{rubrique}",
                   2: "{champ}",
                   3: "{read_value}",
                   4: "{champ}={read_value}",
                  }

    # parsing de la ligne de commande
    description = "Récupération d'informations contenues dans un fichier au format .inf."
    epilog      = "Remplacement simpliste de l'utilitaire ancestral INFfiltre"

    parser = argparse.ArgumentParser(description     = description,
                                     epilog          = epilog,
                                     formatter_class = argparse.RawTextHelpFormatter)

    parser.add_argument('-i',
                        dest='input_file',
                        required=True,
                        metavar='input_file', type=str,
                        help="fichier d'entrée \n" +\
                             "(si option non fournie lecture de l'entrée standard)")

    parser.add_argument('-l',
                        required = True,
                        dest='mode_list',
                        action='store_true',
                        help="mode list (le pendant -t n'est pas codé)")

    parser.add_argument('-f',
                        dest='out_format',
                        metavar='niveau', type=int,
                        help="avec niveau :      \n" +\
                             "  1 : rubrique,      \n" +\
                             "  2 : champ,         \n" +\
                             "  3 : valeur,        \n" +\
                             "  4 : champs=valeur. \n" +\
                             "sans -f : [rubrique] champ=valeur")

    parser.add_argument('-r', '-r0',
                        dest='rubrique',
                        metavar='rubrique', type=str,
                        help="nom de la rubrique")

    parser.add_argument('-c', '-c0',
                        dest='champ',
                        metavar='champ', type=str,
                        help="nom du champ")

    parser.add_argument('-v', '-v0',
                        dest='valeur',
                        metavar='valeur', type=str,
                        help="valeur du champ")

    args = parser.parse_args()

    out_format = "[{rubrique}] {champ}={read_value}"
    if  args.out_format in out_formats.keys():
        out_format = out_formats[ args.out_format ]

    rubrique = args.rubrique
    champ    = args.champ
    valeur   = args.valeur

    # tester l'existence du fichier pour ne pas risquer d'en créer un presque vide
    if not os.path.isfile(args.input_file):
        AIDA.stop_error(f"{args.input_file} : le fichier n'existe pas.")

    # récupération de l'acqid
    acqid = (args.input_file.split('/')[-1]).split('.')[0]

    # lecture du fichier d'input
    try:
        inf = AIDA.Inf(acqid)
    except Exception as e:
        AIDA.stop_error(f"{args.input_file} : erreur de lecture (AIDA.Inf({acqid}))")


    # traitement
    if rubrique:
        if not rubrique in inf._sections:
            sys.exit(1)

        if champ:
            if not champ in inf._sections[rubrique].keys():
                sys.exit(1)

            read_values = inf._sections[rubrique][champ]

            # valeur vaut None ou la valeur passée par l'utilisateur
            print_out(rubrique, champ, valeur, read_values, out_format)
            sys.exit(0)

        else: # pas champ, pas valeur => le contenu de la rubrique
            for champ, read_values in inf._sections[rubrique].items():
                if champ == '__name__':
                    continue

                print_out(rubrique, champ, None, read_values, out_format)
            sys.exit(0)


    if champ:
        for rubrique in inf._sections:
            if champ in inf._sections[rubrique].keys():
                read_values = inf._sections[rubrique][champ]

                # valeur vaut None ou la valeur passée par l'utilisateur
                print_out(rubrique, champ, valeur, read_values, out_format)
        sys.exit(0)


    if valeur:
        for rubrique in inf._sections:
            for champ, read_values in inf._sections[rubrique].items():
                print_out(rubrique, champ, valeur, read_values, out_format)
        sys.exit(0)

    sys.exit(0)
