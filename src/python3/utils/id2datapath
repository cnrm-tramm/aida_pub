#!/usr/bin/env python3

"""
Imprime le répertoire des données de l'acqid passé en argument même si
le répertoire n'existe pas.

  usage :
    {me} <acqid>

  exemple :
    {me} Tf210001

  NOTE : remplacement de la la version C qui nécessite toutes les lib C pour
         sa compilation...
"""

import os
import sys

PYTHON_X_Y = 'python%d.%d' % (sys.version_info[0], sys.version_info[1])
sys.path.append(os.path.join(os.getenv('AIDA_HOME'), 'lib', PYTHON_X_Y))

import AIDA


# concernant ce programme
__version__ = "1.0.0"
me = os.path.split(sys.argv[0])[1]


def usage():
    """ Affiche l'usage.
    """
    print(__doc__.format(me=me))
    sys.exit(1)


if __name__ == '__main__':
    if len(sys.argv) != 2:
        usage()

    acqid = sys.argv[1]

    try:
        data_path = AIDA.ID_to_datapath(acqid)
    except Exception as e:
        print(e, file=sys.stderr)
        sys.exit(1)

    print(f"{data_path}")
    sys.exit(0)
