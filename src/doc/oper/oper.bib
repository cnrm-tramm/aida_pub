@PHDTHESIS{THESE-LAMBERT-97,
  author = {Dominique Lambert},
  title = {Structure moyenne et turbulente de la couche limite atmosphèrique
	au-dessus de l'océan (expérience {SEMAPHORE})},
  school = {Université Toulouse 3 (Paul Sabatier)},
  year = {1997},
  type = {Thèse de l'université Paul Sabatier},
  address = {Toulouse},
  abstract = {Le travail présenté est consacré à une étude de la structure moyenne
	et turbulente de la couche limite atmosphérique au dessus de l'océan,
	réalisée à partir des données de la campagne SEMAPHORE. Les objectifs
	de cette expérience, qui s'est déroulée à l'automne 1993 dans la
	région des Açores, était d'étudier les interactions entre l'océan
	et l'atmosphère à partir de mesures réalisées dans l'océan, à sa
	surface et dans la couche limite atmosphérique. Ce travail s'est
	appuyé principalement sur les données recueillies par deux avions
	de recherche instrumentés. La validation des données réalisée en
	comparant entre elles les mesures effectuées par plusieurs plates-formes
	ainsi qu'une estimation des erreurs lors du calcul des flux ont permis,
	tout d'abord, de fixer les limites de l'analyse physique. Pour réaliser
	cette analyse, la pertinence de la notion de couche de mélange, permettant
	de définir les échelles caractéristiques en vue de la paramétrisation
	de la couche limite, a été mise en lumière. L'analyse statistique
	de la structure turbulente de la couche limite a ensuite été réalisée
	en détails. Une anisotropie des échelles turbulentes liée à un étirement
	des structures dans l'axé du vent moyen a été mise en évidence. Les
	conséquences qui en découlent ont été étudiées. Les profils des principaux
	paramètres turbulents ont été établis en utilisant la normalisation
	par les échelles convectives. Les résultats ont été comparés à des
	études précédentes en couche limite convective. Enfin, la variabilité
	de l'état de couplage de la couche nuageuse avec la couche mélangée
	observée au cours d'une journée a motivé une analyse lagrangienne
	de la couche limite à stratocumulus. Cette étude, réalisée à partir
	des mesures aéroportées et du bateau et confirmée par l'imagerie
	satellitale, a montré que les structures nuageuses se déplaçaient
	dans le flux moyen sans déformation importante sur une période de
	l'ordre de deux heures.},
  keywords = {Couche limite atmosphérique ; Atmosphère marine ; Turbulence atmosphérique
	; Interaction atmosphère océan ; Observation par avion ; Couche mélange
	; Analyse statistique ; Nuage ;}
}

